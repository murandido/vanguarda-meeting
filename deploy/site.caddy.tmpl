# Vanguarda site for the shared Caddy reverse proxy.
# deploy/deploy.sh renders this template (filling in the SITE_DOMAIN placeholder)
# into $SITES_DIR/vanguarda-meeting.caddy; the proxy's Caddyfile imports that directory.
${SITE_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# WebSocket do quadro e, no futuro, SSE do Ritmo: nada de buffer.
	reverse_proxy vanguarda-meeting:3000 {
		flush_interval -1
	}
}
